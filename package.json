{
	"name": "@lilsnibbi/logger",
	"version": "1.1.0",
	"description": "Structured console logger for the Bun runtime, with no styling dependency.",
	"license": "MIT",
	"private": false,
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"src"
	],
	"engines": {
		"bun": "^1.3.13"
	},
	"engineStrict": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lilsnibbi/logger.git"
	},
	"scripts": {
		"typecheck": "bun tsc --noEmit",
		"lint": "bun biome check .",
		"test": "bun test",
		"check": "bun run typecheck && bun run test && bun run release:verify && bun run lint",
		"pretty": "bun biome format --write .",
		"audit": "bun audit --audit-level=high",
		"release": "bun run scripts/release.ts",
		"release:sync": "bun run scripts/syncVersions.ts",
		"release:verify": "bun run scripts/verifyRelease.ts",
		"pub": "bun publish --access public"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "^1.4.0",
		"typescript": "^7.0.2"
	}
}
